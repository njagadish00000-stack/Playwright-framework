# =============================================================================
# Unified Playwright Automation Framework - Example Environment Configuration
# Copy this file to `.env` and adjust values for your machine. NEVER commit
# real credentials. All values here are safe demo defaults.
# =============================================================================

# --- Environment profile: local | dev | qa | staging | prodlike ----------------
ENVIRONMENT=local

# --- Web application under test (UI tests) -------------------------------------
# Default points at the bundled local demo app (starts automatically).
BASE_URL=http://127.0.0.1:8765

# --- REST API under test (API tests) -------------------------------------------
# Default points at the bundled local demo app (starts automatically).
API_BASE_URL=http://127.0.0.1:8765/api

# --- Demo app port (0 = pick a free port automatically) ------------------------
DEMO_APP_PORT=8765
DEMO_APP_HOST=127.0.0.1

# --- Credentials (demo defaults; override via real secrets in CI) --------------
USERNAME=demo
PASSWORD=demo123
API_TOKEN=

# --- Browser configuration -----------------------------------------------------
# BROWSER: chromium | firefox | webkit
BROWSER=chromium
# HEADLESS: true | false
HEADLESS=true
# Optional Playwright device descriptor, e.g. "iPhone 13", "Pixel 5", "" = none
DEVICE=
# Slow down Playwright actions by N milliseconds (0 = off). Useful for headed.
SLOW_MO=0

# --- Timeouts (milliseconds unless noted) --------------------------------------
TIMEOUT=30000
API_TIMEOUT=15
EXPECT_TIMEOUT=10000

# --- Artifacts -----------------------------------------------------------------
# SCREENSHOT_MODE: on-failure | always | never
SCREENSHOT_MODE=on-failure
# VIDEO_MODE: off | on | retain-on-failure
VIDEO_MODE=retain-on-failure
# TRACE_MODE: off | on | on-first-retry | retain-on-failure
TRACE_MODE=retain-on-failure

# --- Execution -----------------------------------------------------------------
# WORKERS: 0|1 = no parallelism, N = fixed workers, auto = all CPUs
WORKERS=0
# If true, UI tests are SKIPPED (with a clear reason) when the selected
# Playwright browser binary is not installed, instead of failing.
SKIP_IF_NO_BROWSER=true

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
